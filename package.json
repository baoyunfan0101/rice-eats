{
  "name": "rice-eats",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:drafts": "RICE_EATS_DRAFTS=1 vite",
    "dev:fixtures": "RICE_EATS_SOURCE=fixtures vite",
    "content:build": "tsx scripts/content/cli.ts build",
    "content:check": "tsx scripts/content/cli.ts check",
    "content:new": "tsx scripts/content/cli.ts new",
    "content:add-images": "tsx scripts/content/cli.ts add-images",
    "content:extract": "tsx scripts/content/cli.ts extract",
    "content:promote": "tsx scripts/content/cli.ts promote",
    "content:publish": "tsx scripts/content/cli.ts publish",
    "images": "tsx scripts/content/cli.ts images",
    "build": "npm run content:build && tsc -b && vite build && tsx scripts/postbuild.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:e2e && playwright test",
    "build:e2e": "RICE_EATS_SOURCE=fixtures tsx scripts/content/cli.ts build && vite build --outDir dist-e2e && tsx scripts/postbuild.ts --e2e",
    "check:privacy": "tsx scripts/check-privacy.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/hast": "^3.0.5",
    "@types/leaflet": "^1.9.22",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "mammoth": "^1.13.0",
    "prettier": "^3.9.10",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "zod": "^4.6.6"
  }
}
